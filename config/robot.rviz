Panels:
  - Class: rviz_common/Displays
    Name: Displays

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Name: Grid
      Value: true

    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.1
      Class: rviz_default_plugins/Pose
      Color: 255; 25; 0
      Head Length: 0.3
      Head Radius: 0.1
      Name: Robot Pose
      Shaft Length: 1
      Shaft Radius: 0.05
      Topic:
        Value: /pose
      Value: true

    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.1
      Class: rviz_default_plugins/Pose
      Color: 0; 255; 0
      Head Length: 0.3
      Head Radius: 0.1
      Name: Goal Pose
      Shaft Length: 1
      Shaft Radius: 0.05
      Topic:
        Value: /goal_pose
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Min Value: 0
      Name: Camera
      Normalize Range: true
      Topic:
        Value: /camera/image_raw
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 255
      Name: LaserScan
      Topic:
        Value: /scan
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/Interact
      Name: Interact
    - Class: rviz_default_plugins/MoveCamera
      Name: MoveCamera

  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.785398
      Target Frame: <Fixed Frame>
      Yaw: 0.785398
